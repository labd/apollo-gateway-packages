{
	"name": "@labdigital/apollo-gateway-packages",
	"private": "true",
	"version": "0.0.0",
	"description": "Various packages for Apollo Gateway",
	"type": "module",
	"keywords": [
		"graphql",
		"authentication"
	],
	"author": "Lab Digital <opensource@labdigital.nl>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/labd/apollo-gateway-packages"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "pnpm turbo build",
		"check": "biome ci && pnpm typecheck",
		"format": "biome format --fix",
		"lint": "biome check",
		"publish:ci": "pnpm build && pnpm changeset publish",
		"publish:version": "pnpm changeset version && pnpm format",
		"test": "vitest run",
		"test:ci": "vitest run --coverage",
		"typecheck": "pnpm turbo typecheck"
	},
	"packageManager": "pnpm@12.12.0",
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@changesets/cli": "^3.0.3",
		"@vitest/coverage-v8": "5.0.3",
		"publint": "^0.3.25",
		"turbo": "^2.11.7",
		"vitest": "5.0.3"
	},
	"engines": {
		"node": ">=22.19"
	}
}
