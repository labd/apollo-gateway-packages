		"@changesets/cli": "^3.0.3",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "5.0.3",
		"graphql": "^16.14.2",
		"tsdown": "^0.23.1",
		"typescript": "^7.0.2",
		"vitest": "5.0.3"
	},
	"peerDependencies": {
		"graphql": ">15.0.0"
	},
	"files": [
		"dist",
		"src"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
